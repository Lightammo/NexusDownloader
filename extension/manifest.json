{
  "manifest_version": 3,
  "name": "Nexus Downloader (IDM Bridge)",
  "version": "0.1.0",
  "description": "把 Nexus Mods 的下载交给 Internet Download Manager。MVP：浏览器扩展 → 本地桥接 → IDM。",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.nexusmods.com/*",
    "https://*.nexus-cdn.com/*",
    "http://127.0.0.1:38765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nexus Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nexusmods.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
